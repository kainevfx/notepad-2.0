{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notepad 2.0",
  "mainBinaryName": "notepad2",
  "version": "0.1.0",
  "identifier": "com.godmode.notepad2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Notepad 2.0",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 260,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "quicknote",
        "url": "quicknote.html",
        "title": "Quick Note",
        "width": 420,
        "height": 480,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "GodMode",
    "category": "Productivity",
    "shortDescription": "Notepad with grouped vertical tabs, Markdown and a tray Quick Note",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
